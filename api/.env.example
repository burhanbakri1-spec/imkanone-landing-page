NODE_ENV=development
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated exact browser origins. In production, use HTTPS origins
# without paths. FRONTEND_ORIGIN is used only when this list is empty.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
FRONTEND_ORIGIN=http://localhost:8080
PUBLIC_API_URL=http://localhost:5000

# Comma-separated dedicated CPanel browser origins (no storefront overlap).
# These are allowlisted in CORS independently from storefront company_domains,
# and bypass storefront domain resolution in resolveCompany.
# Default: cpanel-staging.igroup.website
# CPANEL_ORIGINS=https://cpanel-staging.igroup.website

# One-time trusted-console Super Admin provisioning. Do not commit real values.
# SUPER_ADMIN_EMAIL=admin@example.test
# SUPER_ADMIN_PASSWORD=Replace-With-A-Strong-Placeholder-2026!
# SUPER_ADMIN_NAME=Platform Administrator
# SUPER_ADMIN_ALLOW_UPDATE=false

# Trusted-console PostgreSQL password reset. Keep ADMIN_RESET_ROLE unset or
# "keep" for a password-only update. Never commit real values.
# ADMIN_RESET_EMAIL=admin@example.test
# ADMIN_RESET_PASSWORD=Replace-With-A-Strong-Temporary-Password-2026!
# ADMIN_RESET_ROLE=keep

# Optional persistent storage paths. On hosts with ephemeral filesystems,
# point these to a mounted persistent disk or external volume.
# DATA_STORE_DIR=/var/data/eb-chemical
# UPLOADS_DIR=/var/data/eb-chemical/uploads

# Production persistent storage. When these are set, the backend reads/writes
# data from Supabase PostgreSQL instead of store.json, and uploads images to
# Supabase Storage instead of backend/uploads.
# Copy these into .env for local backend development.
# Do not commit the real SUPABASE_SERVICE_ROLE_KEY.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=paste-your-service-role-key-here
# SUPABASE_BUCKET=eb-chemical-uploads

# Required safety acknowledgement for the read-only staging preflight command.
# Never set this for a production Supabase project.
# STAGING_PREFLIGHT_CONFIRM=staging

# LAN testing:
# FRONTEND_ORIGIN=http://192.168.56.1:8080
# PUBLIC_API_URL=http://192.168.56.1:5000
